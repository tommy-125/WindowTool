<UserControl x:Class="WindowTool.QuickSettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{StaticResource TextBrush}"
             FontFamily="Segoe UI"
             UseLayoutRounding="True">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="30" Height="30" VerticalAlignment="Center">
                <Border x:Name="SelectedIconFallback"
                        Background="{DynamicResource IconFallbackBrush}"
                        CornerRadius="8">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               FontWeight="Bold"
                               Text="?" />
                </Border>
                <Image x:Name="SelectedIcon"
                       Width="28"
                       Height="28"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <StackPanel Grid.Column="2">
                <TextBlock x:Name="SelectedTitleText"
                           FontSize="20"
                           FontWeight="Bold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SelectedProcessText"
                           Margin="0,4,0,0"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,17,10,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="音量" />
                        <TextBlock x:Name="VolumeValueText"
                                   Grid.Column="1"
                                   Foreground="{DynamicResource PrimaryHoverBrush}"
                                   FontSize="15"
                                   FontWeight="Bold" />
                    </Grid>
                    <Slider x:Name="VolumeSlider"
                            Margin="0,9,0,0"
                            Minimum="0"
                            Maximum="100"
                            TickFrequency="5"
                            IsMoveToPointEnabled="True"
                            PreviewKeyUp="VolumeSlider_PreviewKeyUp"
                            PreviewMouseLeftButtonUp="VolumeSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="VolumeSlider_ValueChanged" />

                    <Border Margin="0,18,0,16"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,1,0,0" />

                    <CheckBox x:Name="EnableUnfocusMuteCheckBox"
                              Content="失去焦點時自動靜音"
                              Checked="EnableUnfocusMuteCheckBox_Changed"
                              Unchecked="EnableUnfocusMuteCheckBox_Changed" />
                    <CheckBox x:Name="EnableTopMostCheckBox"
                              Margin="0,15,0,0"
                              Content="保持最上層"
                              Checked="EnableTopMostCheckBox_Changed"
                              Unchecked="EnableTopMostCheckBox_Changed" />

                    <StackPanel Margin="0,18,0,0">
                        <TextBlock Foreground="{StaticResource TextBrush}"
                                   FontWeight="SemiBold"
                                   Text="進階時間設定" />
                        <Grid x:Name="MuteOptionsPanel" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="11" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="靜音延遲" />
                                <TextBox x:Name="UnfocusDelayTextBox"
                                         Margin="0,5,0,0"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         TextChanged="DurationTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="解除延遲" />
                                <TextBox x:Name="FocusDelayTextBox"
                                         Margin="0,5,0,0"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         TextChanged="DurationTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="淡出時間" />
                                <TextBox x:Name="FadeOutTextBox"
                                         Margin="0,5,0,0"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         TextChanged="DurationTextBox_TextChanged" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2">
                                <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontSize="12"
                                           Text="淡入時間" />
                                <TextBox x:Name="FadeInTextBox"
                                         Margin="0,5,0,0"
                                         PreviewTextInput="NumberTextBox_PreviewTextInput"
                                         TextChanged="DurationTextBox_TextChanged" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
