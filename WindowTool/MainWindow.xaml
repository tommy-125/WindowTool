<Window x:Class="WindowTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowTool"
        Title="WindowTool"
        Icon="Assets/WindowTool.ico"
        Width="960"
        Height="540"
        MinWidth="800"
        MinHeight="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        Loaded="MainWindow_Loaded"
        Closing="MainWindow_Closing">
    <Grid Margin="20" Background="{DynamicResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,0,0,0">
            <Grid Margin="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBox x:Name="SearchTextBox"
                             ToolTip="依視窗標題或程式名稱搜尋"
                             TextChanged="SearchTextBox_TextChanged" />
                    <TextBlock Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               IsHitTestVisible="False"
                               Text="搜尋視窗或程式…">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchTextBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <DataGrid x:Name="ProcessDataGrid"
                          Grid.Row="2"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          Foreground="{StaticResource TextBrush}"
                          GridLinesVisibility="None"
                          HeadersVisibility="Column"
                          IsReadOnly="True"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource RowAlternateBrush}"
                          RowHeight="58"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          SelectionChanged="ProcessDataGrid_SelectionChanged">
                    <DataGrid.Resources>
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#273455" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#273455" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
                        <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#FFFFFF" />
                        <Style TargetType="DataGridRow">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource PanelHoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        </Style>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Padding" Value="10,0" />
                            <Setter Property="Height" Value="30" />
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="視窗名稱" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="28" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="24" Height="24"
                                              VerticalAlignment="Center">
                                            <Border x:Name="IconFallback"
                                                    Background="{DynamicResource IconFallbackBrush}"
                                                    CornerRadius="6"
                                                    Visibility="Collapsed">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           FontWeight="Bold"
                                                           Text="{Binding ProcessInitial}" />
                                            </Border>
                                            <Image x:Name="WindowIcon"
                                                   Width="22"
                                                   Height="22"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   RenderOptions.BitmapScalingMode="HighQuality"
                                                   Source="{Binding Icon}" />
                                        </Grid>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding WindowTitle}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       FontSize="11"
                                                       Text="{Binding ProcessName}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                            <Setter TargetName="WindowIcon" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="IconFallback" Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="狀態" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Text="{Binding StatusText}" />
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

            <Border x:Name="SettingsPanelBorder"
                    Grid.Column="2"
                    Background="{DynamicResource PanelBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Visibility="Collapsed">
                <Grid>
                    <local:QuickSettingsWindow x:Name="QuickSettingsPanel"
                                               Visibility="Collapsed" />
                    <StackPanel x:Name="SystemSettingsPanel"
                                Margin="22"
                                Visibility="Collapsed">
                        <TextBlock FontSize="20"
                                   FontWeight="Bold"
                                   Text="系統設定" />
                        <TextBlock Margin="0,5,0,0"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Text="調整 WindowTool 的外觀主題" />
                        <TextBlock Margin="0,28,0,6"
                                   FontWeight="SemiBold"
                                   Text="主題" />
                        <ComboBox x:Name="ThemeComboBox"
                                  SelectedValuePath="Tag"
                                  SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Tag="Midnight" Content="午夜深色" />
                            <ComboBoxItem Tag="Light" Content="淺色" />
                            <ComboBoxItem Tag="Purple" Content="紫色" />
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="準備就緒" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Margin="0,0,14,0"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Content="系統設定"
                        Click="SystemSettingsButton_Click" />
                <TextBlock x:Name="WindowCountText"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Margin="12,0"
                           Foreground="{DynamicResource BorderBrush}"
                           Text="·" />
                <TextBlock x:Name="MonitoredCountText"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
                <TextBlock Margin="12,0"
                           Foreground="{DynamicResource BorderBrush}"
                           Text="·" />
                <TextBlock x:Name="TopMostCountText"
                           Foreground="{DynamicResource SecondaryTextBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
